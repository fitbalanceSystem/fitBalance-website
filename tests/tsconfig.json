{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "../.test-dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@pages/*":   ["cucumber/pages/*"],
      "@steps/*":   ["cucumber/step-definitions/*"],
      "@hooks/*":   ["cucumber/hooks/*"],
      "@fixtures/*":["cucumber/fixtures/*"],
      "@data/*":    ["cucumber/data/*"],
      "@utils/*":   ["cucumber/utils/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "../.test-dist"]
}
